{$PHONE_AGENT_DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 4MB
    }

    reverse_proxy phone-agent:8788 {
        flush_interval -1
        transport http {
            dial_timeout 5s
            response_header_timeout 11m
            read_timeout 30m
            write_timeout 30m
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }

    log {
        output stdout
        format json
    }
}
