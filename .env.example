# PUBLIC Docker control plane. DNS points this name to the Caddy host.
PHONE_AGENT_DOMAIN=phone.example.com
PHONE_AGENT_PUBLIC_URL=https://phone.example.com
PHONE_AGENT_PRODUCTION_MODE=true

# Use different cryptographically random values, each at least 24 characters.
PHONE_AGENT_API_KEY=replace-with-public-api-key-32chars
# One Skill bridge:
PHONE_AGENT_BRIDGE_TOKEN=replace-with-private-wss-key-32chars
# Multiple Skill bridges (preferred at scale); remove BRIDGE_TOKEN when using this:
# PHONE_AGENT_BRIDGE_TOKENS={"lobster-home":"unique-wss-token-32chars","lobster-office":"another-unique-token-32chars"}

PHONE_AGENT_HOST=0.0.0.0
PHONE_AGENT_PORT=8788
PHONE_AGENT_LOG_LEVEL=INFO

# OpenAI-compatible single-action planner. Without MODEL, only direct app launch goals run.
PHONE_AGENT_LLM_BASE_URL=http://host.docker.internal:18080/v1
PHONE_AGENT_LLM_API_KEY=replace-with-model-key
PHONE_AGENT_LLM_MODEL=
PHONE_AGENT_LLM_TIMEOUT_SECONDS=20
PHONE_AGENT_LLM_MAX_OUTPUT_TOKENS=700

PHONE_AGENT_VISION_FALLBACK_ENABLED=false
PHONE_AGENT_VISION_MODEL=
PHONE_AGENT_VISION_TIMEOUT_SECONDS=25
PHONE_AGENT_VISION_MIN_CONFIDENCE=0.82

PHONE_AGENT_ACTION_SETTLE_MS=120
PHONE_AGENT_POST_ACTION_TIMEOUT_MS=2500
PHONE_AGENT_SNAPSHOT_STABLE_INTERVAL_MS=80
PHONE_AGENT_SNAPSHOT_STABLE_TIMEOUT_MS=700
PHONE_AGENT_CONDITION_POLL_MS=160
PHONE_AGENT_CONFIRMATION_TIMEOUT_SECONDS=300
PHONE_AGENT_BRIDGE_RPC_TIMEOUT_SECONDS=15
PHONE_AGENT_BRIDGE_CONNECT_GRACE_SECONDS=5
PHONE_AGENT_BRIDGE_TASK_WAIT_SECONDS=120
PHONE_AGENT_BRIDGE_MAX_MESSAGE_BYTES=2000000
PHONE_AGENT_BRIDGE_HEARTBEAT_SECONDS=20
PHONE_AGENT_MAX_STEPS=40
PHONE_AGENT_MAX_REPAIRS=3
PHONE_AGENT_MAX_SCROLL_SEARCHES=2
PHONE_AGENT_MAX_SAFE_DIALOG_DISMISSALS=3

PHONE_AGENT_ENABLE_A2A=false
PHONE_AGENT_A2A_WAIT_TIMEOUT_SECONDS=900
PHONE_AGENT_CONFIG_DIR=config
PHONE_AGENT_ARTIFACT_DIR=artifacts
PHONE_AGENT_EDGE_MODEL_DIR=
